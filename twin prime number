#include <stdio.h>

int isPrime(int n)
{
    int i;
    if (n < 2)
        return 0;

    for (i = 2; i <= n / 2; i++)
    {
        if (n % i == 0)
            return 0;
    }
    return 1;
}

int main()
{
    int i;

    printf("Twin prime numbers between 1 and 100:\n");

    for (i = 2; i <= 98; i++)
    {
        if (isPrime(i) && isPrime(i + 2))
        {
            printf("(%d, %d)\n", i, i + 2);
        }
    }

    return 0;
}
